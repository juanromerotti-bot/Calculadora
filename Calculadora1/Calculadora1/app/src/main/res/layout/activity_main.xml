<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/lbnDato1"
        android:layout_width="match_parent"
        android:layout_height="29dp"
        android:text="Digita el primer digito"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="29dp" />

    <TextView
        android:id="@+id/lbnDato2"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="Digita el segundo digito"
        app:layout_constraintTop_toBottomOf="@+id/lblNum1"
        tools:layout_editor_absoluteX="1dp" />

    <Button
        android:id="@+id/btnSuma"
        android:layout_width="266dp"
        android:layout_height="46dp"
        android:text="Suma"
        app:layout_constraintTop_toBottomOf="@+id/lbnCalculo"
        tools:layout_editor_absoluteX="75dp" />

    <Button
        android:id="@+id/btnMulti"
        android:layout_width="264dp"
        android:layout_height="49dp"
        android:text="Multiplicación"
        app:layout_constraintTop_toBottomOf="@+id/btnResta"
        tools:layout_editor_absoluteX="77dp" />

    <Button
        android:id="@+id/btnResta"
        android:layout_width="264dp"
        android:layout_height="45dp"
        android:text="Resta"
        app:layout_constraintTop_toBottomOf="@+id/btnSuma"
        tools:layout_editor_absoluteX="77dp" />

    <Button
        android:id="@+id/btnDivi"
        android:layout_width="261dp"
        android:layout_height="50dp"
        android:text="División"
        app:layout_constraintTop_toBottomOf="@+id/btnMulti"
        tools:layout_editor_absoluteX="77dp" />

    <EditText
        android:id="@+id/lblNum1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@+id/lbnDato1"
        tools:layout_editor_absoluteX="0dp" />

    <EditText
        android:id="@+id/lblNum2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@+id/lbnDato2"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/lbnResultado"
        android:layout_width="411dp"
        android:layout_height="31dp"
        android:text="Resultado"
        app:layout_constraintTop_toBottomOf="@+id/lblNum2"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/lbnCalculo"
        android:layout_width="411dp"
        android:layout_height="31dp"
        app:layout_constraintTop_toBottomOf="@+id/lbnResultado"
        tools:layout_editor_absoluteX="0dp" />
</androidx.constraintlayout.widget.ConstraintLayout>